{
  "Jwt": {
    "Issuer": "Kodvian.Core.Api",
    "Audience": "Kodvian.Core.Frontend",
    "Key": "SET_JWT_KEY_IN_ENVIRONMENT_32_CHARS_MINIMUM",
    "ExpirationMinutes": 30
  },
  "AuthSeed": {
    "AdminEmail": "admin@kodvian.local",
    "AdminPassword": "Admin12345!",
    "AdminFullName": "Administrador General"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "Storage": {
    "BasePath": "App_Data/files",
    "MaxPdfSizeMb": 10
  },
  "GitHub": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.github.com",
    "DefaultLabel": "kodvian"
  },
  "TokenEncryption": {
    "Key": "local-dev-token-encryption-key-32chars!"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
